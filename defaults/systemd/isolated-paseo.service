[Unit]
Description=Isolated Paseo and Cloudflare Tunnel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=infinity
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/isolated-paseo/service.env
WorkingDirectory=%h/Projects/isolated-paseo
ExecStartPre=/usr/bin/docker compose up -d
ExecStart=/usr/bin/env cf tunnels run ${CLOUDFLARE_TUNNEL_ID}
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
