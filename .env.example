# Use absolute paths to private files outside this repository.
PASEO_PASSWORD_ENV_FILE=/absolute/path/to/paseo-password.env
FIGMA_SECRETS_DIR=/absolute/path/to/figma
PASEO_PORT=6767
PASEO_WORKSPACE=./workspace
PASEO_CACHE=./cache
PASEO_CONFIG=./config
PASEO_DATA=./data
PASEO_CPUS=12
PASEO_MEMORY=20g
# Total memory plus swap, not additional swap.
PASEO_MEMSWAP=28g
PASEO_PIDS=1024
PASEO_TMP_SIZE=12g
PASEO_RUN_SIZE=1g
